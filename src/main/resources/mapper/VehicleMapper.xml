<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.traffic_management.mapper.VehicleMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.example.traffic_management.entity.Vehicle">
        <id column="id" property="id"/>
        <result column="BandName" property="bandName"/>
        <result column="licenseNumber" property="licenseNumber"/>
        <result column="typeCode" property="typeCode"/>
        <result column="currentLatitude" property="currentLatitude"/>
        <result column="currentLongitude" property="currentLongitude"/>
        <result column="currentAction" property="currentAction"/>
        <result column="isDeleted" property="isDeleted"/>
        <result column="remaining_time" property="remainingTime"/>
        <result column="distance_to_pickup" property="distanceToPickup"/>
        <result column="transport_distance" property="transportDistance"/>
    </resultMap>

    <!-- 公共查询列，避免各处 SELECT 列表不一致（缺列会导致仿真读到 null） -->
    <sql id="BaseColumns">
        id, BandName, licenseNumber, typeCode, currentLatitude, currentLongitude,
        currentAction, isDeleted, remaining_time, distance_to_pickup, transport_distance
    </sql>

    <!-- 1. 根据主键查询 -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vehicle
        WHERE id = #{id}
    </select>

    <!-- 2. 查询所有 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vehicle
        ORDER BY id
    </select>

    <!-- 2.5 查询未删除的车辆 -->
    <select id="selectAllNotDeleted" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vehicle
        WHERE isDeleted = 0 OR isDeleted IS NULL
        ORDER BY id
    </select>

    <!-- 3. 插入 -->
    <insert id="insert" parameterType="com.example.traffic_management.entity.Vehicle"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vehicle (BandName, licenseNumber, typeCode, currentLatitude, currentLongitude, currentAction, isDeleted)
        VALUES (#{bandName}, #{licenseNumber}, #{typeCode}, #{currentLatitude}, #{currentLongitude}, #{currentAction}, 0)
    </insert>

    <!-- 4. 更新（可选字段只在非空时写入，避免把已有值覆盖成 NULL） -->
    <update id="update" parameterType="com.example.traffic_management.entity.Vehicle">
        UPDATE vehicle
        <set>
            BandName = #{bandName},
            licenseNumber = #{licenseNumber},
            typeCode = #{typeCode},
            currentLatitude = #{currentLatitude},
            currentLongitude = #{currentLongitude},
            currentAction = #{currentAction},
            <if test="isDeleted != null">isDeleted = #{isDeleted},</if>
            <if test="remainingTime != null">remaining_time = #{remainingTime},</if>
            <if test="distanceToPickup != null">distance_to_pickup = #{distanceToPickup},</if>
            <if test="transportDistance != null">transport_distance = #{transportDistance},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 5. 物理删除 -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM vehicle WHERE id = #{id}
    </delete>

    <!-- 6. 软删除 -->
    <update id="softDeleteById" parameterType="java.lang.Integer">
        UPDATE vehicle
        SET isDeleted = 1
        WHERE id = #{id}
    </update>

    <!-- 查询空闲车辆：CurrentAction 是 int 外键（1 = 空闲），不能拿中文名称比较 -->
    <select id="findFreeVehicles" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM vehicle
        WHERE currentAction = 1
          AND (isDeleted = 0 OR isDeleted IS NULL)
        ORDER BY id
    </select>

    <!-- 重置仿真：所有车辆回到空闲 -->
    <update id="resetAllStates">
        UPDATE vehicle
        SET currentAction = 1,
            remaining_time = 0,
            distance_to_pickup = 0,
            transport_distance = 0
    </update>

</mapper>
