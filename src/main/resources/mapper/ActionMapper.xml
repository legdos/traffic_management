<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.traffic_management.mapper.ActionMapper">
 <resultMap id="BaseResultMap" type="com.example.traffic_management.entity.Action"><id column="code" property="id"/><result column="name" property="actionName"/><result column="action_type" property="actionType"/><result column="default_duration_sec" property="duration"/><result column="accident_rate" property="accidentRate"/></resultMap>
 <select id="selectById" resultMap="BaseResultMap">SELECT code,name,action_type,default_duration_sec,accident_rate FROM action_definition WHERE code=#{id}</select>
 <select id="selectAll" resultMap="BaseResultMap">SELECT code,name,action_type,default_duration_sec,accident_rate FROM action_definition ORDER BY code</select>
 <insert id="insert">INSERT INTO action_definition(code,name,action_type,default_duration_sec,accident_rate) VALUES(#{id},#{actionName},#{actionType},#{duration},#{accidentRate})</insert>
 <update id="update">UPDATE action_definition SET name=#{actionName},action_type=#{actionType},default_duration_sec=#{duration},accident_rate=#{accidentRate} WHERE code=#{id}</update>
 <delete id="deleteById">DELETE FROM action_definition WHERE code=#{id}</delete>
</mapper>
